{
  "name": "reason",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Reason: a general-purpose agent that lives in your texts. The model is the controller.",
  "scripts": {
    "chat": "node --env-file-if-exists=.env src/chat.js",
    "serve": "node --env-file-if-exists=.env src/serve.js",
    "test": "node --env-file-if-exists=.env --test test/*.test.js",
    "test:offline": "ANTHROPIC_API_KEY= node --test test/*.test.js",
    "signin": "node --env-file-if-exists=.env src/signin-cli.js",
    "probe:sites": "node --env-file-if-exists=.env scripts/probe-sites.js",
    "rehearse:calls": "node --env-file-if-exists=.env scripts/call-rehearsal.mjs",
    "data:export": "node --env-file-if-exists=.env src/data.js export",
    "data:delete": "node --env-file-if-exists=.env src/data.js delete"
  },
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "playwright": "^1.63.0",
    "zod": "^3.23.8"
  }
}

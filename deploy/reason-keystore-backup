#!/bin/bash
# Encryption at rest: the daily backup of data/keys.db (the per-person keys, wrapped by the master key),
# to its OWN restic repo that keeps only the last 3 snapshots. Installed as
# /usr/local/bin/reason-keystore-backup, run by reason-keystore-backup.timer after the off-site backup.
#
# Why its own repo: the off-site repo is append-only (the box can never prune it), so a keys.db inside
# it would keep a deleted person's key forever, openable by the KMS key. Here only 3 days are kept, so
# 3 days after "delete my data" no copy of their key exists anywhere, and every old reason.db backup
# holds their words with no key. reason-offsite-backup must exclude data/keys.db* for that to hold.
#
# Home: its own restic repo on the Hetzner Storage Box (./reason-keystore), reached with its own key
# /root/.ssh/reason_keystore_ed25519, which the Storage Box pins to `rclone serve restic --stdio
# ./reason-keystore`: it can read and prune that repo only, never the append-only off-site one.
# So this box keeps the last 3 itself; no Mac needed. (Root here could also delete these: the cost is
# at most 3 days of keystore history, the live keys.db stays.)
# Repo password: /root/.reason-keystore-pass (600 root); its copy is in the owner's recovery bundle.
set -euo pipefail
D=/opt/reason/data
export RESTIC_REPOSITORY="rclone:reason-keystore"
export RESTIC_PASSWORD_FILE=/root/.reason-keystore-pass
P="ssh -p 23 -i /root/.ssh/reason_keystore_ed25519 -o IdentitiesOnly=yes -o BatchMode=yes -o ServerAliveInterval=60 u713360@u713360.your-storagebox.de"
restic() { command restic -o rclone.program="$P" "$@"; }
[ -f "$D/keys.db" ] || { echo "keystore backup: no $D/keys.db (encryption at rest not on yet)"; exit 0; }
TMP=$(mktemp -d); trap 'rm -rf "$TMP"' EXIT
sqlite3 "$D/keys.db" ".backup '$TMP/keys.db'"
[ "$(sqlite3 "$TMP/keys.db" 'PRAGMA integrity_check;')" = "ok" ] || { echo "keystore backup: integrity check failed" >&2; exit 1; }
restic snapshots >/dev/null 2>&1 || restic init
( cd "$TMP" && restic backup --host reason --tag keystore --quiet keys.db )
restic forget --keep-last 3 --prune --quiet
echo "keystore backup ok: $(restic snapshots --json | python3 -c 'import json,sys; print(len(json.load(sys.stdin)))') snapshot(s) kept"

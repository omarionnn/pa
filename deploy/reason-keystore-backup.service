# Encryption at rest: daily keys.db backup to its own 3-snapshot S3 repo (deploy/reason-keystore-backup).
#   cp deploy/reason-keystore-backup /usr/local/bin/ && cp deploy/reason-keystore-backup.{service,timer} /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now reason-keystore-backup.timer
[Unit]
Description=Reason keystore backup (keys.db, keep last 3)
After=reason-offsite-backup.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/reason-keystore-backup
TimeoutStartSec=300

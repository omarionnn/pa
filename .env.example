# ---- the brain ----
ANTHROPIC_API_KEY=
# Brain model. Default claude-opus-5.
REASON_MODEL=claude-opus-5
# Where the SQLite file lives. Default data/reason.db
REASON_DB_PATH=data/reason.db

# ---- who you are ----
REASON_OWNER_NAME=Omari
REASON_OWNER_CITY=New York
REASON_TZ=America/New_York
# Your own number, E.164. THIS is what makes a text "the owner's": a number that is not on this
# list gets its own thread and can never spend, connect an account, or act on anyone. Leave it
# empty and every inbound text is a stranger's. Comma-separate if you text from more than one.
REASON_OWNER_NUMBER=

# ---- who gets a Reason ----
# The MASTER: a normal account with its own private Reason, plus admin rights. One number here
# gives exactly the single-owner install this started as. REASON_OWNER_NUMBER is still read, so an
# existing .env keeps working; this name wins if both are set. E.164, comma-separated.
REASON_MASTER_NUMBER=
# Anyone may text Reason. A number with no account gets ONE line saying access is being asked for,
# and the master is texted: who is asking, their first message quoted exactly, and the question.
# NOTHING a stranger says reaches the model until the master says yes. The master answers in plain
# words and the guard reads it.
# How long a declined number is left alone before the master is troubled about it again.
REASON_DECLINE_COOLOFF_DAYS=7
# At most this many access requests put to the master in an hour; the rest queue.
REASON_MAX_REQUESTS_PER_HOUR=5
# And at most this many in a day, however they arrived. The rest wait and are asked about later.
REASON_MAX_REQUESTS_PER_DAY=10
# The website's "request access" form (POST /access/web). The form's own server signs each request
# with this secret, and with it unset the route does not exist. Put the same value in the website
# host's settings. Never in the page a browser loads, and never in a repo.
REASON_WEB_ACCESS_SECRET=
# How many new numbers the website may put in the queue in a day.
REASON_WEB_ACCESS_PER_DAY=30
# How long before somebody still waiting is told, once, that they are still waiting.
REASON_WAITING_GAP_MIN=360
# How long the master has to answer one request before it goes stale.
REASON_ACCESS_WINDOW_MIN=10080
# Per person, per day. 0 means uncapped. These are what stop one person running up your bill.
REASON_MAX_TURNS_PER_DAY=120
REASON_MAX_PROACTIVE_PER_DAY=8
# How long before somebody whose Reason is paused or removed is told again. Once a day.
REASON_TURNED_AWAY_GAP_MIN=1440

# ---- noticing things first ----
# The watchful sweep: Reason going and looking at a connected mailbox and calendar for the thing
# that slipped, rather than waiting to be asked. Everything here is a decision about WHEN to look
# and HOW MANY times to speak, which is code's; what is worth saying is the model's.
#
# How often it looks, per person. Two hours. Somebody can ask for more or less ("check more often",
# "text me less") and that is saved on their account, which beats this.
REASON_NOTICE_EVERY_MS=7200000
# Nothing unprompted between these two hours, in THEIR time zone — unless the catch is marked urgent
# with a reason on it. This is the DEFAULT, and only the default: the first time there is anything to
# watch, Reason asks them once for their zone and the hours they are happy being texted in, and their
# answer beats both this and the zone read off their calendar.
REASON_NOTICE_QUIET_START=22
REASON_NOTICE_QUIET_END=8
# The budget. ONE unprompted text a day per person, counted in the database and reset at their own
# local midnight, because one great catch a day beats five generic ones. The second number is the
# ceiling nothing gets past, including something urgent. 0 on the first means nothing unprompted at
# all, which is also what somebody saying "don't text me unless I text you" sets on their account.
REASON_NOTICE_PER_DAY=1
REASON_NOTICE_HARD_CAP=3
# How far ahead a calendar change counts as worth noticing (48h — a meeting moving next month is
# not news today), and how far ahead a bill or an appointment in the mail does (7 days).
REASON_NOTICE_HORIZON_HOURS=48
REASON_NOTICE_BILL_DAYS=7
# How long somebody they know has to have been waiting on a reply before it is worth mentioning.
# Under a day is just somebody being normal about email.
REASON_NOTICE_WAITING_HOURS=24
# When a catch about something on their calendar actually goes out: about this long before the
# thing, so it lands while there is still time to react — except when the thing MOVED and is inside
# the second window, which is too soon to sit on and goes straight away.
REASON_NOTICE_LEAD_MIN=120
REASON_NOTICE_NOW_HOURS=6
# How many extra mailbox reads one sweep may spend working out whether a sender is somebody they
# actually know. Past this the rest of the unread mail is simply not a candidate that time round,
# which costs a sweep and never a wrong answer.
REASON_NOTICE_CONTACT_PROBES=6
# For somebody who asked for ONE batched line instead of a text when something turns up: the hour of
# their own clock it goes at. Their own chosen hour beats this. And how long a "snooze for today"
# lasts before it expires on its own — nobody should have to remember to turn initiative back on.
REASON_NOTICE_DIGEST_HOUR=18
REASON_NOTICE_SNOOZE_HOURS=24

# ---- the model backend ----
# Unset (or "api") is the Anthropic API, which is how Reason is deployed. "claude-cli" runs every
# turn through the `claude` CLI on a personal Claude subscription: the operator's own testing only.
# On that backend ONLY the numbers below get answers; anybody else gets one "not available yet"
# line and no model turn. With a real channel connected and this empty, serve refuses to start.
# An ANTHROPIC_API_KEY with credit is required before anybody but the operator is served.
# REASON_BACKEND=claude-cli
REASON_TEST_NUMBERS=

# ---- pages ----
# The address `npm run serve` is reachable at from outside, no trailing slash. This is what makes
# a page link openable on a phone. Leave it empty and pages still work, but their links only open
# on this machine — and Reason says so instead of sending you one that will not work.
REASON_PUBLIC_URL=
# Optional. A dedicated domain for page links, e.g. https://files.heyreason.com. When set,
# page URLs use this domain without the /p/ prefix ({REASON_PAGES_URL}/{id}) instead of the default
# {REASON_PUBLIC_URL}/p/{id}. The server still serves them at /p/{id} — the proxy in front rewrites.
REASON_PAGES_URL=
# Optional. The status page's address, the one every link Reason sends the owner for it uses (alert
# texts, "back to normal", the status_page tool), with ?k= on the end. Defaults to
# https://heyreason.com/ops, which the website proxies here. Empty = {REASON_PUBLIC_URL}/ops.
# REASON_OPS_URL=https://heyreason.com/ops
# Optional. The status page's password, as a hash: scrypt:<saltHex>:<hashHex> from
# node -e 'const c=require("crypto"),s=c.randomBytes(16);console.log("scrypt:"+s.toString("hex")+":"+c.scryptSync(process.argv[1],s,64).toString("hex"))' 'the password'
# Set, /ops asks for it on a browser not already signed in; unset, the page has the texted code only.
# REASON_OPS_PASSWORD_HASH=
# Optional. The shared secret the Mac's coding-subscription reporter signs its pushes to /ops/usage
# with (HMAC-SHA256; scripts/usage-reporter.py, src/subusage.js). Unset, the endpoint answers 404 and
# the status page's "Coding subscription" row says the Mac has never reported.
# REASON_USAGE_INGEST_SECRET=
# Optional. A fuller website about this Reason, e.g. https://textreason.netlify.app. When set, the
# plain home page at {REASON_PUBLIC_URL}/ links to it at the bottom. Empty means no link.
REASON_SITE_URL=

# Optional. When Reason's texting line moved off the shared +1 808 number (src/linechange.js).
# Anybody who texted before it gets the new contact card, once, the first time they text after it.
# Default 2026-10-23T15:50:00Z.
REASON_LINE_CHANGE_AT=

# ---- texting (Sendblue) ----
# iMessage / SMS / RCS. The two keys are the two headers every Sendblue request needs
# (sb-api-key-id, sb-api-secret-key); get them from dashboard.sendblue.com or `sendblue show-keys`.
# SENDBLUE_API_KEY / SENDBLUE_API_SECRET are also read, because that is what Sendblue's own Chat
# SDK adapter calls them.
SENDBLUE_API_KEY_ID=
SENDBLUE_API_SECRET_KEY=
# REQUIRED, not optional: Sendblue's send endpoint takes from_number on every message and there is
# no "pick a line for me" form. This is your Sendblue number, E.164. `sendblue lines` lists them.
# If it is the free SHARED line: a text from any number without a verified-contact route on it is
# dropped by Sendblue before the webhook — Reason never hears it. Make the route first
# (POST https://api.sendblue.co/v3/verified-contacts {"phone_number"}), then have THEM text first;
# that text verifies the route and is their first message. Sending to a pending route is a 400.
SENDBLUE_FROM_NUMBER=
# The shared secret you set on the receive webhook in the Sendblue dashboard (Developer →
# Webhooks), pointed at http(s)://your-host/channels/sendblue/webhook. With this empty, EVERY
# webhook is refused — Sendblue signs nothing, so the secret is the only proof a request is theirs.
SENDBLUE_WEBHOOK_SECRET=
# Optional. The header Sendblue sends that secret back in. Their docs never name it; their Chat SDK
# adapter defaults to sb-signing-secret, so that is the default here. Change it if the real
# webhooks arrive with the secret somewhere else.
SENDBLUE_WEBHOOK_SECRET_HEADER=
# With any of the four above empty, Sendblue reports not_connected and Reason says texting is
# unavailable rather than pretending a message went out.

# ---- texting (Linq, the earlier channel) ----
# Superseded by Sendblue and kept so an existing .env is not broken. Both adapters can be
# configured at once; each is only live with its own credentials.
# Generate the token at dashboard.linqapp.com/api-tooling. The signing secret comes from the
# webhook subscription you point at http(s)://your-host/channels/linq/webhook and starts whsec_.
LINQ_API_KEY=
LINQ_WEBHOOK_SECRET=
# Optional: the number Reason texts from, for display. Linq picks the line itself by default.
LINQ_FROM_NUMBER=

# ---- phone calls ----
# Which provider dials. 'fake' is the default and places no real calls at all. Two real ones:
#
#   bland       (src/calls/bland.js) their voice, handed a prompt once. Outbound only.
#   elevenlabs  (src/calls/elevenlabs.js) their line, REASON'S OWN BRAIN turn by turn, both
#               directions — people can ring the number and talk to their own Reason.
#
# Either is live only with its own keys below, and with the name set and a key missing, capabilities
# says phone calls are not connected and Reason tells people so rather than offering.
REASON_CALL_PROVIDER=fake

# A key from app.bland.ai/dashboard/settings. Sent as `authorization: Bearer <key>`.
# Nothing about this is free once it runs: Bland's published Start-plan rate is $0.14 a connected
# minute, so the two caps at the bottom of this block are what stands between one person and the bill.
BLAND_API_KEY=
# Optional. A number on your own Bland account to call FROM. With this empty, "calls are initiated
# from a separate pool of numbers owned by Bland", which is the ordinary case on a new account.
BLAND_FROM_NUMBER=
# Optional, and worth having. Bland signs its post-call webhooks with HMAC-SHA256 over the body,
# hex, in the X-Webhook-Signature header. The secret is made by hand in the dashboard under
# Settings -> Keys -> "Replace Secret", and is shown once.
#
# With this EMPTY the call-finished webhook is still accepted, on the strength of the unguessable
# per-call token in its URL and nothing else. That is weaker than a signature. With it set, an
# unsigned delivery is rejected.
BLAND_WEBHOOK_SECRET=
# Where the post-call webhook is sent, built from REASON_PUBLIC_URL (further up) as
#   {REASON_PUBLIC_URL}/calls/bland/webhook/{a token minted for that one call}
# With no REASON_PUBLIC_URL no webhook URL is sent at all, and outcomes are polled by call_status
# instead — Bland's own docs call polling the right answer for an agent with no inbound URL rather
# than a workaround, so nothing is broken by leaving it unset.
BLAND_API_BASE=https://api.bland.ai
BLAND_TIMEOUT_MS=20000

# ---- Reason itself on the phone: ElevenLabs Agents + a Twilio number ----
# docs/calls-elevenlabs-setup.md is the half hour of account setup that produces every value here.
# Nothing is free once it runs: ElevenLabs' Agents speech engine was $0.08 a connected minute on
# 2026-10-05, plus Twilio's own per-minute voice rate, plus a model turn for every thing said. The
# two caps at the bottom of this block are what stands between one person and the bill, and they
# count a call that came IN as well as one that went out.
#
# elevenlabs.io -> profile -> API keys. Sent as `xi-api-key`, not a bearer token.
ELEVENLABS_API_KEY=
# elevenlabs.io/app/agents — the agent holding the voice, the languages and the Custom LLM URL.
ELEVENLABS_AGENT_ID=
# elevenlabs.io/app/agents/phone-numbers -> Import, with a purchased Twilio number. IMPORT it rather
# than verifying a caller ID: a verified caller ID is outbound-only, and half of this is people
# ringing you.
ELEVENLABS_PHONE_NUMBER_ID=
# The bearer secret ElevenLabs is configured to send to Reason's own custom-LLM endpoint
# (https://{REASON_PUBLIC_URL}/calls/elevenlabs/llm). Pick anything long and random; it goes in the
# agent's Custom LLM settings and here.
#
# NOT optional. With this empty, that endpoint refuses every request. Unprotected it is a way for
# anybody to spend this machine's model credit and have somebody's private thread read out loud.
ELEVENLABS_LLM_SECRET=
# The signing secret on the post-call webhook (https://{REASON_PUBLIC_URL}/calls/elevenlabs/post-call).
# Also NOT optional, and unlike Bland's there is no fallback: a post-call delivery writes a transcript
# into somebody's own conversation, so an unsigned one is refused.
ELEVENLABS_WEBHOOK_SECRET=
# One voice, picked by listening, used on every call. Optional: with this empty the agent's own
# configured voice is used, which still speaks — so a call is never refused over it.
ELEVENLABS_VOICE_ID=
ELEVENLABS_API_BASE=https://api.elevenlabs.io
ELEVENLABS_TIMEOUT_MS=20000

# Which backend answers a VOICE turn. Empty means the same one every other turn uses, so an install
# that sets nothing behaves exactly as it does now. Set it to `api` for real calls: a phone turn
# cannot wait on a headless CLI start, while the rest of Reason may still be on the subscription.
REASON_CALL_BACKEND=
# How many turns of the person's own thread a voice turn is handed. Short on purpose — a phone turn
# pays for every token in the gap before the first word.
REASON_CALL_HISTORY_TURNS=12

# How long one call may run before it is cut off, in minutes.
REASON_CALL_MAX_MINUTES=10
# What one person may spend on calls in a day. 0 means uncapped.
#
# These exist because a call is the only thing in Reason that bills by the minute: a turn is a
# fixed number of tokens, while a call runs at a per-minute rate for as long as whoever picked up
# keeps talking. 30 minutes a day is roughly $4.20 at Bland's published rate.
#
# The minute cap is counted from calls that have FINISHED, because that is the first moment a
# call's real length exists — so the last call of the day may run over it by up to
# REASON_CALL_MAX_MINUTES, and the cap stops the next one.
REASON_MAX_CALLS_PER_DAY=10
REASON_MAX_CALL_MINUTES_PER_DAY=30

# ---- web search and research ----
# What turns "I read Apple's page" into "I searched four ways, read six sources, here is the pick".
# With this empty there is NO searching: the capabilities tool says search is not connected, the
# research tool refuses rather than guessing, and Reason falls back to reading a page whose address
# it can name itself — and says that is what it did.
#
# Parallel — web search built for agents: ranked pages with long excerpts, not one-line snippets.
# Get a key at platform.parallel.ai. 5,000 searches a month free. Docs: docs.parallel.ai.
PARALLEL_API_KEY=
# "fast" (~700ms, default) or "advanced" (~3s, deeper). Excerpt cap per search in characters.
# PARALLEL_SEARCH_MODE=fast
# PARALLEL_SEARCH_MAX_CHARS=8000
# PARALLEL_API_BASE=https://api.parallel.ai
#
# Context.dev — search and scrape provider. One API for web search, scraping, and more.
# Get a key at context.dev/dashboard/api-keys. Docs: docs.context.dev.
# Search: 1 credit per 10 results. Scrape: from 1 credit.
# Also powers web_lookup (page reading), falling back to plain fetch if unavailable.
CONTEXT_DEV_API_KEY=
# Tavily — backup search provider. Used when Context.dev fails at runtime.
# Get a key at app.tavily.com. 1,000 API credits a month, free, NO CREDIT CARD.
TAVILY_API_KEY=
# Which provider to use: "parallel", "contextdev" (default) or "tavily". When the named one fails
# at runtime, parallel falls back to contextdev and contextdev to tavily, whichever has a key.
# REASON_SEARCH_PROVIDER=contextdev
# "basic" (1 credit) or "advanced" (2 credits, better relevance) for Tavily.
# TAVILY_SEARCH_DEPTH=basic
# TAVILY_API_BASE=https://api.tavily.com
#
# What stops one question running away. Counted across a whole run, however many turns it spans, and
# when a cap is what ended a run the answer says so instead of looking finished.
# REASON_RESEARCH_MAX_SEARCHES=5
# REASON_RESEARCH_MAX_PAGES=8
# REASON_RESEARCH_MAX_SECONDS=90
#
# The rest of Parallel, all on the same PARALLEL_API_KEY (src/parallel.js):
# - Page reading. "parallel" puts Extract first for web_lookup, research page reads and watchers:
#   JavaScript pages and PDFs, and a research run gets the part of the page ABOUT its question.
#   $1 per 1,000 pages. "contextdev" (default) keeps Context.dev first. Either falls through.
# REASON_LOOKUP_PROVIDER=contextdev
# - Deep research. A `deep: true` question also goes to the Task API as one async run on this
#   processor, which reads far past the page cap and comes back with citations and a confidence.
#   pro ~$0.10 a run, ultra ~$0.30. "local" keeps the old page-by-page path only.
# REASON_RESEARCH_DEEP_PROVIDER=parallel
# PARALLEL_DEEP_PROCESSOR=pro
# - A plain fact. One cited answer from the Responses API before Reason's own searches; "none" to
#   turn it off. low ~5–10s ($0.01), medium ~15–20s ($0.05).
# REASON_RESEARCH_ANSWER_PROVIDER=parallel
# PARALLEL_ANSWER_EFFORT=low
# - Watching the world. watch_set with a `query` and no URL makes a Parallel monitor: lite is $3 per
#   1,000 checks (a daily check ≈ 9¢ a month).
# PARALLEL_MONITOR_PROCESSOR=lite
# - Verified lists (find_all): base is $0.25 a run plus $0.03 a match, capped by the limit.
# PARALLEL_FINDALL_GENERATOR=base
# PARALLEL_FINDALL_LIMIT=20
# - Webhooks. Settings → Webhooks on platform.parallel.ai; the secret starts whsec_. With it, a deep
#   run or a monitor event wakes Reason the moment it lands at REASON_PUBLIC_URL/parallel/webhook.
#   Without it, Reason polls on the task's own schedule, which works but later.
PARALLEL_WEBHOOK_SECRET=

# ---- video ----
# yt-dlp is what gets at a video at all: its details, its captions and (for listening) its audio
# track. It needs no key. Install it however suits the machine — `pipx install yt-dlp`, `brew install
# yt-dlp`, or the standalone binary from github.com/yt-dlp/yt-dlp — and either put it on the PATH or
# name it here. With it missing, the video tool and the capabilities tool both say so rather than
# guessing at what a video says.
# REASON_YTDLP_BIN=/usr/local/bin/yt-dlp
#
# A VIDEO MODEL, for when the captions will not do — no captions at all, garbled ones, or a question
# about something you can only see. Google's Gemini; get a key at aistudio.google.com.
#   - a YOUTUBE link is handed straight over and Gemini WATCHES it, picture and sound. Nothing is
#     downloaded, and this is the only case where Reason may say it watched something.
#   - any OTHER site: Gemini takes uploaded audio, not an arbitrary page, so Reason pulls the AUDIO
#     TRACK ONLY, uploads that, and gets a transcript. Audio means no picture, and the result says so.
# With this empty, a caption-less video comes back as "no captions, and no video model is connected"
# and Reason says exactly that rather than guessing.
# Cost per Google's docs (2026-10-05): a video is ~100 tokens per SECOND at default media resolution
# (6,000 a minute), audio is 32 tokens per second (1,920 a minute). On gemini-3.8-flash at its
# current $0.75/M input that is roughly 0.45 cents a minute to watch and 0.14 cents a minute to
# listen, plus output. There is a free tier, capped at 8 hours of YouTube a day. Public videos only.
# Every account is cached per video and per tier, so the same video is never paid for twice.
GEMINI_API_KEY=
# Reason's own voice (voice_note_say) and listening to voice notes both use the Gemini key above.
# Speaking also needs an audio converter: afconvert on a Mac (already there), ffmpeg anywhere else.
# REASON_TTS_MODEL=gemini-3.8-flash-tts
# REASON_TTS_VOICE=Puck
# REASON_HEAR_FALLBACK_MODEL=gemini-3.5-flash-lite
# Their docs name Gemini 3.8 Flash, 3.7 Flash, 3.6 Flash and 3.5 Flash Lite as taking YouTube URLs.
# REASON_VIDEO_MODEL=gemini-3.8-flash
# How long a video the model will take on in one go. A money limit, not a model limit (Gemini allows
# 9.5 hours of audio a prompt): an hour of video is around 27 cents. Over this, Reason refuses in
# plain words rather than quietly spending it.
# REASON_VIDEO_MAX_MINUTES=60
# Where audio goes on its way to being transcribed. Deleted as soon as the transcript is stored.
# REASON_AUDIO_TMP=data/audio-tmp
#
# OPTIONAL, and not what the audio path uses: an OpenAI speech-to-text transcriber, and a local
# Whisper that is documented rather than installed (src/transcribe.js). Both are offline-tested and
# run only if REASON_TRANSCRIBER says so. Gemini does the audio otherwise.
# REASON_TRANSCRIBER=
# OPENAI_API_KEY=
# REASON_TRANSCRIBE_MODEL=whisper-1
# How much transcript comes back at once, in characters. ~20k is about 35 minutes of talking; a
# longer video is cut and the result says exactly which stretch is missing.
# REASON_VIDEO_TRANSCRIPT_CHARS=20000

# ---- Spotify ----
# Their Web API, connected the documented way: the authorization code flow (docs read 2026-10-05).
# Make an app at developer.spotify.com/dashboard and put its client id and secret here.
#
# THEN THE BIT THAT CATCHES EVERYONE: add Reason's callback address to the app's Redirect URIs,
# spelled exactly as Reason builds it, or the authorize step fails on Spotify's side and says very
# little about why. Reason prints the exact string — `npm run serve` then GET /health shows
# `spotify.redirect_uri`, and the spotify_connect tool returns it too. It is:
#
#     http://127.0.0.1:8787/spotify/callback      with no REASON_PUBLIC_URL
#     <REASON_PUBLIC_URL>/spotify/callback        with one
#
# Note 127.0.0.1 and not localhost: Spotify's redirect-URI rules forbid `localhost` by name and
# require the explicit loopback IP, so Reason never emits the other form.
#
# Access tokens last an hour and are refreshed automatically. Refresh tokens last six months, after
# which the person authorizes again — Reason says so rather than failing quietly.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ---- Google: their Gmail and their calendar ----
# A Web application OAuth client from console.cloud.google.com/auth/clients, with the Gmail API and
# the Calendar API enabled on the project. Reason asks for exactly two scopes and no others:
#   https://www.googleapis.com/auth/gmail.modify   read, search, draft, send, label, archive, bin
#   https://www.googleapis.com/auth/calendar       read the calendar and write to it
# gmail.modify deliberately does NOT allow deleting mail for good — that needs https://mail.google.com/,
# which is not requested, so the bin is as far as Reason can go and it says so.
#
# Add this to the client's Authorized redirect URIs, exactly — scheme, case and trailing slash all
# have to match or Google answers redirect_uri_mismatch:
#   {REASON_PUBLIC_URL}/google/callback
# Without REASON_PUBLIC_URL the address is http://127.0.0.1:<port>/google/callback, which Google
# allows (localhost is exempt from both the https rule and the no-raw-IP rule) but which only opens
# on the machine Reason runs on.
#
# There is deliberately NO GOOGLE_OAUTH_REFRESH_TOKEN here. That was the old shape, from before every
# person who texts had their own Reason, and one refresh token in this file would mean everybody who
# texted reached the SAME inbox. The client id and secret are the machine's; each person's refresh
# token is theirs, given on Google's own consent screen and stored against their conversation.
#
# While your consent screen is in Testing (Google console → Audience): only the test users listed
# there can connect at all, and Google expires their refresh tokens after 7 days. Published but
# unverified: anyone can connect past a "Google hasn't verified this app" screen, up to 100 people.
# Whenever Google ends a grant, Reason treats that as a reconnect — it says so plainly with a fresh
# link and never retries a dead grant.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ---- what a person may commit in a day ----
# Whole dollars, per person, per day. 0 turns it off. Counted in the database from the amounts that
# were really approved, so restarting the process does not reset it, and it is enforced in the gate
# rather than asked of the model: over the limit, a commit is refused BEFORE it happens and Reason
# says the real numbers. The per-action yes still stands on top of this.
#
# Worth knowing what it can and cannot see: the amount comes out of the one-line details the person
# agreed to, which is the only number anybody has actually said yes to. A commit whose approved
# details name no amount is not in the total — which is why browser_submit separately refuses to
# commit on one of the known sites when the page shows a price and the approval does not.
REASON_MAX_SPEND_PER_DAY=300

# ---- saved sign-ins ----
# There is no variable here, and that is the design. A site is connected by YOU signing in yourself,
# once, in a real browser window:
#
#     npm run signin -- amazon          opens a window on Amazon's sign-in page
#     npm run signin -- --list          what is signed in, and when it was last checked
#     npm run signin -- --check amazon  re-ask the site now
#     npm run signin -- --forget amazon clear that site's cookies and stop claiming it is connected
#
# No password is ever typed into Reason, in a message or anywhere else. What is kept is the session
# the site itself set, in that person's own browser profile under REASON_PROFILE_ROOT. Which sites
# a browser will even talk to is a separate question: `npm run probe:sites` goes and finds out, and
# docs/site-probe-2026-10-05.json is the last run.

# ---- local testing on a Claude subscription, owner only ----
# REASON_BACKEND=claude-cli runs the turn through the `claude` CLI instead of the API, so the
# live tests can be exercised without API credit. See the README. Never for other people's installs.
REASON_BACKEND=

# ---- what they send: photos, voice notes, links ----
# Nothing here is required. The two things that matter are already on a Mac:
#   sips     converts an iPhone HEIC into something the vision model can read. /usr/bin/sips,
#            part of macOS. Without it, a HEIC gets an honest refusal instead of a conversion.
#   afconvert turns Apple's .caf voice notes into WAV. /usr/bin/afconvert, also part of macOS.
#            ffmpeg is used instead when it is there.
# Listening to a voice note needs a model that takes audio, which is GEMINI_API_KEY above. With no
# key, a voice note is reported as not listened to and why — never guessed at.
REASON_IMAGE_MAX_BYTES=7340032
# How long a voice note has to be before its transcript keeps timestamps. Under this a note is a
# sentence or two and [0:00] markers are noise; over it, "where did they say that" is a real question.
REASON_VOICE_TIMESTAMP_AFTER_SEC=30

# ---- how long any of it is kept ----
# Two numbers, in days. 0 on either means keep forever.
#   CONTENT is the stuff itself: the words in a voice note, a page or video Reason fetched, a call's
#           transcript and its audio, the history of a conversation nobody has touched since.
#   RECORDS is the much smaller fact that something happened — a row saying a voice note arrived on
#           the 3rd and was transcribed, the provider id that stops a redelivery being answered
#           twice. No content in any of it, so it is kept longer; deleting those early is not a
#           privacy win, it is a redelivered message getting a second real answer.
# The sweep runs on the same interval as everything else proactive, so it cannot quietly stop.
# `npm run data:delete` is still immediate and total and does not wait for either of these.
REASON_KEEP_CONTENT_DAYS=30
REASON_KEEP_RECORDS_DAYS=365
# `--log` cuts every long string in a tool call to a length and a count, so a page or a transcript
# is not written into a terminal. Set this to 1 only for a session where the content IS the thing
# being debugged.
REASON_LOG_CONTENT=

# Seals stored AgentCard tokens at rest (AES-256-GCM, src/secretbox.js). REQUIRED: the server will not
# start without it. 32 bytes as 64 hex characters: openssl rand -hex 32. Never commit it; losing it
# means every person reconnects their AgentCard vault.
REASON_TOKEN_KEY=

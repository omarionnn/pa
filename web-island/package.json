{
  "name": "reason-crossmint-island",
  "private": true,
  "description": "Build-only. Bundles Crossmint's protected input and card form for src/pages/webconnect.js. Not a runtime dependency of Reason.",
  "scripts": {
    "build": "esbuild island.jsx --bundle --minify --format=iife --target=es2020 --jsx=automatic --define:process.env.NODE_ENV=\\\"production\\\" --legal-comments=none --alias:crypto=./shims/empty.js --outfile=../assets/connect/crossmint-island.js"
  },
  "dependencies": {
    "@crossmint/client-sdk-react-ui": "4.13.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  }
}

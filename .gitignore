# No trailing slash: a worktree's node_modules is a symlink, and 'node_modules/' only matches a directory.
node_modules
.env
.env.*
!.env.example
data/
*.db
*.log
.DS_Store
# Voice notes the call rehearsal writes (scripts/call-rehearsal.mjs): audio of a pretend call, worth
# listening to once and not worth keeping in the history.
rehearsal/
# The flight search sidecar is Python (scripts/fli_sidecar.py).
__pycache__

# npm run web:staging writes the static staging site here
dist
